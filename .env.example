NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/sankalp-village-project

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# --- AI features (lesson planner + Ask agent). Optional; the app runs without them. ---
# Any provider with an OpenAI-compatible API. Set at least one key.
GROQ_API_KEY=            # free, fast; chat only (no embeddings)
GEMINI_API_KEY=          # free tier; chat (20 req/day on flash) + embeddings
OPENAI_API_KEY=          # paid
# Which provider answers chat/agent requests: groq | gemini | openai
# (default: first of those with a key)
LLM_PROVIDER=groq
# Which provider embeds resources for RAG: gemini | openai
# (default: LLM_PROVIDER if it can embed, else gemini). Changing this or the
# embedding model requires `npm run seed-resources` to re-embed the library.
EMBEDDING_PROVIDER=gemini
# Optional model overrides
# LLM_CHAT_MODEL=openai/gpt-oss-120b
# LLM_EMBEDDING_MODEL=gemini-embedding-001
# Retrieval tuning (defaults are the values the evals in server/evals were run with)
# RETRIEVAL_MODE=vector            # vector | hybrid — re-run `npm run eval:retrieval` before switching
# RAG_SIMILARITY_THRESHOLD=0.62    # overrides the per-embedding-model default; measure before changing

# Google OAuth 2.0 credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# --- Optional hardening / configuration ---
# Restrict Google sign-in to one email domain. Unset = any Google account may join.
ALLOWED_EMAIL_DOMAIN=lnmiit.ac.in
# Where attendance may be recorded, when a session has no location of its own.
SCHOOL_LAT=26.933531637176955
SCHOOL_LNG=75.9162266441557
ATTENDANCE_RADIUS_M=1000
# How long the auth middleware caches a user record, in ms.
USER_CACHE_TTL_MS=15000
