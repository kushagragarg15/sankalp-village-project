{
  "name": "sankalps-village-project-server",
  "version": "1.0.0",
  "description": "Backend for Sankalp's Village Project - Volunteer-Driven Learning Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "clear-data": "node scripts/clearData.js",
    "list-users": "node scripts/listUsers.js",
    "manage-roles": "node scripts/manageUserRoles.js",
    "change-role": "node scripts/quickRoleChange.js",
    "create-test-volunteers": "node scripts/createTestVolunteers.js",
    "create-test-students": "node scripts/createTestStudents.js",
    "create-test-data": "npm run create-test-volunteers && npm run create-test-students",
    "seed-resources": "node scripts/seedResources.js",
    "update-user-role": "node scripts/updateUserRole.js",
    "update-all-roles": "node scripts/updateAllUserRoles.js",
    "seed-club-data": "node scripts/seedClubData.js",
    "prep-next-session": "node scripts/prepNextSession.js",
    "eval:retrieval": "cross-env RAG_QUIET=1 node evals/retrieval.js",
    "eval:generation": "cross-env RAG_QUIET=1 node evals/generation.js",
    "mcp": "node mcp/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migratePg.js",
    "migrate-to-pg": "node scripts/migrateToPg.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "education",
    "volunteer",
    "rural",
    "lms"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "openai": "^4.38.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.5.2",
    "nodemon": "^3.1.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "app.js",
      "middleware/**/*.js",
      "controllers/**/*.js",
      "utils/**/*.js",
      "db/serialize.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ]
  }
}
