PORT=8000
ENVIRONMENT=development

# Same PostgreSQL database server/db/pool.js connects to.
DATABASE_URL=postgres://user:password@localhost:5432/sankalp
DATABASE_SSL=false

# Shared secret for the Node -> Python hop. Must match AI_SERVICE_TOKEN in
# server/.env exactly. Generate with: openssl rand -hex 32
AI_SERVICE_TOKEN=

# --- LLM provider selection (foundation only; see app/llm.py) ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=gemini
# LLM_CHAT_MODEL=openai/gpt-oss-120b
# LLM_EMBEDDING_MODEL=gemini-embedding-001
